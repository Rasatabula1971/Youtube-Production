# YouTube Data API key used for official metadata/search when quota is available.
YOUTUBE_API_KEY=

# vidIQ MCP supplemental Opportunity Engine intelligence.
# Generate an MCP-only API key in vidIQ Account Settings -> MCP.
# Free currently provides 150 AI credits/month. This project hard-clamps its
# own monthly budget to 149 credits and verifies provider balance before every
# paid call. Most research tools used here cost 5 credits each.
VIDIQ_MCP_API_KEY=
VIDIQ_MCP_URL=https://mcp.vidiq.com/mcp
VIDIQ_MONTHLY_CREDIT_CAP=149
VIDIQ_MAX_PAID_CALLS_PER_RUN=9

# Optional overrides for the separate FAIR Free AI Router checkout.
# Leave blank to use the default sibling-repository location.
FAIR_REPO_PATH=
FAIR_PYTHON=
FAIR_ENV_FILE=

# Comma-separated FAIR providers you have explicitly confirmed are free-only.
FAIR_CONFIRMED_FREE_PROVIDERS=


# Optional direct Gemini backup used only after FAIR returns a clean
# non-accepted result with paid_inference_executed=false.
# Keep this key in the YouTube project .env, separate from FAIR's .env.
# This backup is outside FAIR's free-only guarantee and may be billed.
DIRECT_GEMINI_API_KEY=
DIRECT_GEMINI_MODEL=gemini-3.5-flash

# Optional local Ollama vision drafting for Experiment 02.
# Leave EXPERIMENT_02_VISION_MODEL blank for human-only visual review.
# The model must already be installed in local Ollama.
EXPERIMENT_02_VISION_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
