  "made_for_kids_excluded": true,
  "evidence_rules": {
    "historical_demand": [
      {
        "rule_id": "HD-01.5-PASS",
        "level": "STRONG",
        "description": "At least one Experiment 01.5 PASS packet: replicated topic channels, velocity samples, age-matched index, replicated depth family and the view reference."
      },
      {
        "rule_id": "HD-01.5-REVIEW",
        "level": "MODERATE",
        "description": "Topic evidence is ready but no packet passed the depth-family or view-reference conditions."
      }
    ],
    "cross_channel_replication": [
      {
        "rule_id": "CCR-TOPIC-STRONG",
        "level": "STRONG",
        "minimum_unique_channels": 6,
        "description": "The topic/format cell has at least 6 independent channels."
      },
      {
        "rule_id": "CCR-TOPIC-MODERATE",
        "level": "MODERATE",
        "minimum_unique_channels": 3,
        "description": "The topic/format cell has at least 3 independent channels."
      },
      {
        "rule_id": "CCR-TOPIC-LOW",
        "level": "LOW",
        "minimum_unique_channels": 1,
        "description": "Fewer than 3 independent channels."
      }
    ],
    "human_topic_demand": [
      {
        "rule_id": "HT-DEMAND-STRONG",
        "level": "STRONG",
        "minimum_channels": 3,
        "minimum_views": 500000,
        "description": "At least 3 independent channels have a relevant search result with 500K+ views (search sample, not the age-matched 01.3 engine)."
      },
      {
        "rule_id": "HT-DEMAND-MODERATE",
        "level": "MODERATE",
        "minimum_channels": 1,
        "minimum_views": 500000,
        "description": "At least one relevant search result has 500K+ views."
      },
      {
        "rule_id": "HT-DEMAND-WEAK",
        "level": "WEAK",
        "minimum_channels": 1,
        "minimum_views": 0,
        "description": "Relevant videos exist but none has reached 500K views."
      }
    ],
    "human_topic_replication": [
      {
        "rule_id": "HT-CCR-STRONG",
        "level": "STRONG",
        "minimum_channels": 6,
        "minimum_views": 100000,
        "description": "At least 6 independent channels have a relevant video with 100K+ views."
      },
      {
        "rule_id": "HT-CCR-MODERATE",
        "level": "MODERATE",
        "minimum_channels": 3,
        "minimum_views": 100000,
        "description": "At least 3 independent channels have a relevant video with 100K+ views."
      },
      {
        "rule_id": "HT-CCR-LOW",
        "level": "LOW",
        "minimum_channels": 1,
        "minimum_views": 100000,
        "description": "One or two independent channels have a relevant video with 100K+ views."
      },
      {
        "rule_id": "HT-CCR-NONE",
        "level": "NONE",
        "minimum_channels": 0,
        "minimum_views": 100000,
        "description": "No relevant video with 100K+ views was found."
      }
    ],
    "viral_replication": [
      {
        "rule_id": "CL-REPLICATED-STRONG",
        "level": "STRONG",
        "description": "5+ independent channels breaking out on the same question, mechanism or topic."
      },
      {
        "rule_id": "CL-REPLICATED",
        "level": "MODERATE",
        "description": "3-4 independent channels breaking out on the same question, mechanism or topic."
      },
      {
        "rule_id": "CL-EVENT-BOUND",
        "level": "LOW",
        "description": "Replicated, but around one news event: weaker evidence of durable demand."
      },
      {
        "rule_id": "CL-PAIR",
        "level": "LOW",
        "description": "Two independent channels share the theme."
      },
      {
        "rule_id": "CL-ONE-OFF",
        "level": "NONE",
        "description": "No other independent channel is breaking out on this theme."
      }
    ]
  },
  "human_topic": {
    "max_seed_chars": 160,
